new file mode 100644
index 0000000..521b8e6
--- /dev/null
+++ b/tests/testapp/zss-query-probe.c
@@ -0,0 +1,54 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* No GPU submissions: distinguish an allocated pool from a recorded query. */
+#include <vulkan/vulkan.h>
+#include <stdio.h>
+#include <stdlib.h>
+#define OK(call) do { VkResult r = (call); if (r != VK_SUCCESS) { fprintf(stderr, "%s: %d\n", #call, r); return 2; } } while (0)
+int main(int argc, char **argv)
+{
+    VkInstance instance;
+    VkInstanceCreateInfo ici = { .sType = VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO };
+    OK(vkCreateInstance(&ici, NULL, &instance));
+    uint32_t count = 1;
+    VkPhysicalDevice physical;
+    VkResult result = vkEnumeratePhysicalDevices(instance, &count, &physical);
+    if ((result != VK_SUCCESS && result != VK_INCOMPLETE) || !count) return 3;
+    VkQueueFamilyProperties families[64];
+    count = 64;
+    vkGetPhysicalDeviceQueueFamilyProperties(physical, &count, families);
+    uint32_t family;
+    for (family = 0; family < count; ++family)
+        if (families[family].queueFlags & VK_QUEUE_GRAPHICS_BIT) break;
+    if (family == count) return 4;
+    float priority = 1;
+    VkDeviceQueueCreateInfo queue = { .sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO,
+        .queueFamilyIndex = family, .queueCount = 1, .pQueuePriorities = &priority };
+    VkDeviceCreateInfo dci = { .sType = VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO,
+        .queueCreateInfoCount = 1, .pQueueCreateInfos = &queue };
+    VkDevice device;
+    OK(vkCreateDevice(physical, &dci, NULL, &device));
+    VkQueryPoolCreateInfo qci = { .sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO,
+        .queryType = VK_QUERY_TYPE_TIMESTAMP, .queryCount = 2 };
+    VkQueryPool pool;
+    OK(vkCreateQueryPool(device, &qci, NULL, &pool));
+    VkCommandPool commands = VK_NULL_HANDLE;
+    if (argc > 1) {
+        VkCommandPoolCreateInfo pci = { .sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO, .queueFamilyIndex = family };
+        OK(vkCreateCommandPool(device, &pci, NULL, &commands));
+        VkCommandBufferAllocateInfo ai = { .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO,
+            .commandPool = commands, .level = VK_COMMAND_BUFFER_LEVEL_PRIMARY, .commandBufferCount = 1 };
+        VkCommandBuffer cb;
+        OK(vkAllocateCommandBuffers(device, &ai, &cb));
+        VkCommandBufferBeginInfo bi = { .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO };
+        OK(vkBeginCommandBuffer(cb, &bi));
+        vkCmdResetQueryPool(cb, pool, 0, 2);
+        OK(vkEndCommandBuffer(cb));
+    }
+    puts("ready"); fflush(stdout);
+    getchar();
+    if (commands) vkDestroyCommandPool(device, commands, NULL);
+    vkDestroyQueryPool(device, pool, NULL);
+    vkDestroyDevice(device, NULL);
+    vkDestroyInstance(instance, NULL);
+    return 0;
+}
