+VKAPI_ATTR VkResult VKAPI_CALL zss_CreateQueryPool(VkDevice device, const VkQueryPoolCreateInfo *ci,
+                                                 const VkAllocationCallbacks *alloc, VkQueryPool *out)
+{
+    ENTER(device);
+    struct zss_obj *o = zss_obj_new(dev, ZK_QUERYPOOL);
+
