+/* Unlike hardware attach, rendering restore never thaws cgroups or contacts
+ * clients that have no context originating on this GPU. */
+static void render_restore(struct gpu *g, char *failed, size_t n, const pid_t *only)
+{
+    int gi = (int)(g - gpus);
+    pid_t asked[MAX_CLIENTS] = {0};
+
+    failed[0] = '\0';
+    for (int i = 0; i < MAX_CLIENTS; i++) {
+        struct client *c = &clients[i];
+
+        if (only && only[i] != c->pid)
+            continue;
+        if (c->fd >= 0 && c->registered && c->view[gi].origin > 0 && c->frozen) {
+            snprintf(failed, n, "application %d is frozen by a hardware operation", c->pid);
+            return;
+        }
+    }
+    for (int i = 0; i < MAX_CLIENTS; i++) {
+        struct client *c = &clients[i];
+        struct zj_out o;
+
+        if (c->fd < 0 || !c->registered || c->view[gi].origin <= 0 || (only && only[i] != c->pid))
+            continue;
+        asked[i] = c->pid;
+        zj_begin(&o, "restore");
+        zj_add_str(&o, "gpu", g->pci);
+        ask(c, &o);
+    }
+    wait_outcomes();
+    for (int i = 0; i < MAX_CLIENTS; i++)
+        if (asked[i] && (clients[i].fd < 0 || clients[i].pid != asked[i] || clients[i].outcome != OC_MIGRATED)) {
+            snprintf(failed, n, "application %d did not complete the rendering restore", asked[i]);
+            return;
+        }
+}
+
+/* Move tracked rendering contexts without releasing hardware. Display/presentation
+ * handles may legitimately remain on the source GPU. This operation must never
+ * call a backend, freeze a process, or advertise that a device can be removed. */
+static void do_move(struct client *req, struct gpu *g, const char *to, bool restore)
+{
+    int gi = (int)(g - gpus), moved = 0;
+    pid_t asked[MAX_CLIENTS] = {0};
+    pid_t origins[ZSSD_MAX_GPUS][MAX_CLIENTS] = {{0}};
+    char failed[400] = "", msg[512], path[300], klass[32];
+    struct gpu *target_gpu = gpu_find(to);
+    bool present_target;
+
+    snprintf(path, sizeof(path), "/sys/bus/pci/devices/%.15s/class", to);
+    present_target = strlen(to) == 12 && read_text(path, klass, sizeof(klass)) == 0 &&
+                     (strtoul(klass, NULL, 16) >> 16) == 0x03;
+    if (target_gpu && (target_gpu->state != GS_ATTACHED || target_gpu->dry_detached || target_gpu->off))
+        present_target = false;
+    if (g->state != GS_ATTACHED || g->dry_detached || g->off) {
+        send_result(req, false, "", "render-only moves require an attached GPU", g);
+        return;
+    }
+    if (restore) {
+        render_restore(g, failed, sizeof(failed), NULL);
+        send_result(req, !failed[0], "", failed[0] ? failed :
+                    "rendering restored; GPU driver, power and display server were left unchanged", g);
+        return;
+    }
+    if (!to[0] || !strcmp(to, g->pci) ||
+        (!strcmp(to, "software") ? !allow_software : !present_target)) {
+        send_result(req, false, "", "name a different, present target GPU with --to (software requires --allow-software)", g);
+        return;
+    }
+    /* Refuse before touching any client if a known render context cannot move.
+     * Unregistered applications are outside this operation and remain alone. */
+    for (int i = 0; i < MAX_CLIENTS; i++) {
+        struct client *c = &clients[i];
+
+        if (c->fd >= 0 && c->registered && c->view[gi].devices > 0 && (!c->view[gi].migratable || c->frozen || !c->render_only)) {
+            send_result(req, false, "", "a registered rendering context is not migratable", g);
+            return;
+        }
+    }
+    for (int i = 0; i < MAX_CLIENTS; i++) {
+        struct client *c = &clients[i];
+        struct zj_out o;
+
+        c->outcome = OC_NONE;
+        if (c->fd < 0 || !c->registered || c->view[gi].devices <= 0)
+            continue;
+        asked[i] = c->pid;
+        for (int j = 0; j < ngpus; j++)
+            if (c->view[j].origin > 0)
+                origins[j][i] = c->pid;
+        zj_begin(&o, "migrate");
+        zj_add_str(&o, "from", g->pci);
+        zj_add_str(&o, "to", to);
+        zj_add_bool(&o, "render_only", true);
+        ask(c, &o);
+        moved++;
+    }
+    wait_outcomes();
+    for (int i = 0; i < MAX_CLIENTS; i++) {
+        struct client *c = &clients[i];
+
+        if (asked[i] && (c->fd < 0 || c->pid != asked[i] || c->outcome != OC_MIGRATED)) {
+            snprintf(failed, sizeof(failed), "application %d did not complete the rendering move", asked[i]);
+            break;
+        }
+    }
+    if (failed[0]) {
+        /* Best effort return to origin. Never freeze a parked application. */
+        char rollback[400] = "";
+
+        /* A context currently on g may have started on another GPU. Restore
+         * participating clients to their actual origins, not just to g. */
+        for (int j = 0; j < ngpus; j++) {
+            char error[400];
+            render_restore(&gpus[j], error, sizeof(error), origins[j]);
+            if (error[0] && !rollback[0])
+                snprintf(rollback, sizeof(rollback), "%s", error);
+        }
+        snprintf(msg, sizeof(msg), "%s; origin restore %s", failed,
+                 rollback[0] ? "also failed; inspect status" : "requested");
+        send_result_with_uncertainty(req, false, "", msg, g, rollback[0] != '\0');
+    } else {
+        snprintf(msg, sizeof(msg), "%d application(s) moved; GPU driver, power and display server were left unchanged", moved);
+        send_result(req, true, "", msg, g);
+    }
+}
