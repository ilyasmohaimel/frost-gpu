+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Render-only protocol regression tests. Fake clients, no GPU or power backend."""
+import json
+import os
+import socket
+import threading
+import time
+from zsstest import Daemon, FAKE_PCI, check, run_scenarios
+
+OTHER_PCI = 'ffff:01:00.0'
+
+class Client:
+    def __init__(self,d,migratable=True,park=False,restore_park=False,on_source=True,origin_gpu=FAKE_PCI,render_only=True):
+        self.sock=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM);self.sock.settimeout(4);self.sock.connect(d.socket)
+        self.stream=self.sock.makefile('r');self.messages=[];self.requests=[];self.restore_gpus=[];self.error=None;self.park=park;self.restore_park=restore_park;self.origin=int(on_source and origin_gpu==FAKE_PCI)
+        self.send(type='register',name='fake-renderer',render_only_version=int(render_only))
+        welcome=json.loads(self.stream.readline());check(welcome['type']=='welcome',str(welcome))
+        self.state(int(on_source),migratable)
+        if origin_gpu != FAKE_PCI:
+            self.send(type='state',gpu=origin_gpu,devices=0,origin=1,holds=False,migratable=True,parked=0)
+        # A same-socket status roundtrip orders the state before the CLI request.
+        self.send(type='status')
+        while json.loads(self.stream.readline())['type']!='end':pass
+        self.thread=threading.Thread(target=self.answer,daemon=True);self.thread.start()
+    def send(self,**message):self.sock.sendall((json.dumps(message)+'\n').encode())
+    def state(self,devices,migratable=True,parked=0):
+        self.send(type='state',gpu=FAKE_PCI,devices=devices,origin=self.origin,holds=True,migratable=migratable,parked=parked)
+    def answer(self):
+        try:
+            while line:=self.stream.readline():
+                m=json.loads(line);self.messages.append(m['type']);self.requests.append(m)
+                if m['type']=='migrate':
+                    self.state(0,parked=int(self.park));self.send(type='outcome',id=m['id'],result='parked' if self.park else 'migrated')
+                elif m['type']=='restore':
+                    self.restore_gpus.append(m['gpu'])
+                    if m['gpu']==FAKE_PCI:self.state(0 if self.restore_park else 1,parked=int(self.restore_park))
+                    else:self.send(type='state',gpu=m['gpu'],devices=1,origin=1,holds=True,migratable=True,parked=0)
+                    self.send(type='outcome',id=m['id'],result='parked' if self.restore_park else 'migrated')
+        except (OSError,ValueError):pass
+        except Exception as e:self.error=str(e)
+    def close(self):
+        self.sock.shutdown(socket.SHUT_RDWR);self.thread.join(1);self.stream.close();self.sock.close()
+        check(self.error is None,str(self.error))
+
+def pure_move_needs_no_backend_and_keeps_gpu_attached():
+    d=Daemon('--gpu',FAKE_PCI,'--allow-software')
+    c=None
+    try:
+        c=Client(d)
+        rc,out=d.ctl('move',FAKE_PCI,'--to','software',timeout=6);check(rc==0 and '1 application(s) moved' in out,out)
+        rc,out=d.ctl('status');check('backend=none' in out and 'migrated-away' in out and 'dry run' not in out,out)
+        rc,out=d.ctl('restore',FAKE_PCI,timeout=6);check(rc==0 and 'rendering restored' in out,out)
+        rc,out=d.ctl('status');check('state=attached' in out and 'migrated-away' not in out,out)
+        check(c.messages==['migrate','restore'],str(c.messages))
+        check('detaching' not in d.log_text(),'render-only operation entered hardware detach')
+    finally:
+        if c:c.close()
+        d.stop()
+
+def bad_targets_do_not_touch_clients():
+    d=Daemon('--gpu',FAKE_PCI)
+    c=None
+    try:
+        c=Client(d)
+        for args in [('move',FAKE_PCI),('move',FAKE_PCI,'--to',FAKE_PCI),('move',FAKE_PCI,'--to','software'),('move',FAKE_PCI,'--to','no-such-gpu')]:
+            rc,out=d.ctl(*args,timeout=6);check(rc!=0,out)
+        check(not c.messages,str(c.messages))
+    finally:
+        if c:c.close()
+        d.stop()
+
+def non_migratable_is_rejected_before_moving():
+    d=Daemon('--gpu',FAKE_PCI,'--allow-software');c=None
+    try:
+        c=Client(d,migratable=False)
+        rc,out=d.ctl('move',FAKE_PCI,'--to','software',timeout=6)
+        check(rc!=0 and 'not migratable' in out,out);check(not c.messages,str(c.messages))
+    finally:
+        if c:c.close()
+        d.stop()
+
+def parked_client_is_restored_not_frozen_or_reported_as_success():
+    d=Daemon('--gpu',FAKE_PCI,'--allow-software');c=None
+    try:
+        c=Client(d,park=True)
+        rc,out=d.ctl('move',FAKE_PCI,'--to','software',timeout=6)
+        check(rc!=0 and 'origin restore requested' in out,out)
+        check(c.messages==['migrate','restore'],str(c.messages))
+        rc,out=d.ctl('status');check(' parked' not in out and 'migrated-away' not in out,out)
+    finally:
+        if c:c.close()
+        d.stop()
+
+def parked_restore_is_not_reported_as_success():
+    d=Daemon('--gpu',FAKE_PCI,'--allow-software');c=None
+    try:
+        c=Client(d,restore_park=True)
+        rc,out=d.ctl('move',FAKE_PCI,'--to','software',timeout=6);check(rc==0,out)
+        rc,out=d.ctl('restore',FAKE_PCI,timeout=6)
+        check(rc!=0 and 'did not complete the rendering restore' in out,out)
+    finally:
+        if c:c.close()
+        d.stop()
+
+def failed_reverse_move_restores_actual_origin_and_leaves_others_alone():
+    d=Daemon('--gpu',FAKE_PCI,'--gpu',OTHER_PCI,'--allow-software');c=unrelated=None
+    try:
+        c=Client(d,park=True,origin_gpu=OTHER_PCI)
+        unrelated=Client(d,on_source=False,origin_gpu=OTHER_PCI)
+        rc,out=d.ctl('move',FAKE_PCI,'--to','software',timeout=6)
+        check(rc!=0 and 'origin restore requested' in out,out)
+        check(c.restore_gpus==[OTHER_PCI],str(c.restore_gpus))
+        check(not unrelated.messages,str(unrelated.messages))
+    finally:
+        if c:c.close()
+        if unrelated:unrelated.close()
+        d.stop()
+
+def restore_ignores_unrelated_clients():
+    d=Daemon('--gpu',FAKE_PCI);c=None
+    try:
+        c=Client(d,on_source=False)
+        rc,out=d.ctl('restore',FAKE_PCI,timeout=6)
+        check(rc==0,out);check(not c.messages,str(c.messages))
+    finally:
+        if c:c.close()
+        d.stop()
+
+def authorisation_applies_to_both_new_operations():
+    if os.geteuid()==0:return 'root is always authorised'
+    d=Daemon('--gpu',FAKE_PCI,'--allow-software','--no-owner-access','--group','zss-no-such-group')
+    try:
+        for args in [('move',FAKE_PCI,'--to','software'),('restore',FAKE_PCI)]:
+            rc,out=d.ctl(*args,timeout=6);check(rc!=0 and 'permission denied' in out,out)
+    finally:d.stop()
+
+if __name__=='__main__':
+    raise SystemExit(run_scenarios([
+      ('render-only move and restore without a power backend',pure_move_needs_no_backend_and_keeps_gpu_attached),
+      ('bad targets leave clients alone',bad_targets_do_not_touch_clients),
+      ('known non-migratable contexts refuse before moving',non_migratable_is_rejected_before_moving),
+      ('parked move fails and restores instead of freezing',parked_client_is_restored_not_frozen_or_reported_as_success),
+      ('parked restore is reported as a failure',parked_restore_is_not_reported_as_success),
+      ('failed reverse move restores actual origin without unrelated clients',failed_reverse_move_restores_actual_origin_and_leaves_others_alone),
+      ('restore leaves unrelated clients alone',restore_ignores_unrelated_clients),
+      ('move and restore enforce authorisation',authorisation_applies_to_both_new_operations),
+    ]))
