+    assert(updates==1 && view->refs==3);
+    struct zss_obj *copy=make_set(&dev,VK_DESCRIPTOR_TYPE_STORAGE_TEXEL_BUFFER);
+    VkCopyDescriptorSet cp={.sType=VK_STRUCTURE_TYPE_COPY_DESCRIPTOR_SET,.srcSet=ZHANDLE(VkDescriptorSet,set),.srcBinding=0,.dstSet=ZHANDLE(VkDescriptorSet,copy),.dstBinding=0,.descriptorCount=2};
