+    assert(real_buffer_view(&dev,view)==VK_SUCCESS);
+    assert(view->u.buffer_view.ci.pNext!=&usage && view->u.buffer_view.ci.offset==16);
+    struct zss_obj *set=make_set(&dev,VK_DESCRIPTOR_TYPE_UNIFORM_TEXEL_BUFFER);
+    VkBufferView virtual_views[2]={ZHANDLE(VkBufferView,view),ZHANDLE(VkBufferView,view)};
+    VkWriteDescriptorSet write={.sType=VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET,.dstSet=ZHANDLE(VkDescriptorSet,set),.dstBinding=0,.descriptorCount=2,.descriptorType=VK_DESCRIPTOR_TYPE_UNIFORM_TEXEL_BUFFER,.pTexelBufferView=virtual_views};
+    expected_view=(VkBufferView)(uintptr_t)view->r.h;
