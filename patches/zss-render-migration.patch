new file mode 100644
index 0000000..1b5ab3c
--- /dev/null
+++ b/tests/test_query_pool.py
@@ -0,0 +1,53 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Explicit two-GPU probe. No submissions, hardware detach or power changes."""
+import json
+import os
+from pathlib import Path
+import selectors
+import subprocess
+import sys
+import tempfile
+from zsstest import Daemon, BUILD, ZSS_RUN, check
+
+if len(sys.argv) != 3:
+    raise SystemExit('usage: test_query_pool.py SOURCE_PCI TARGET_PCI')
+source, target = sys.argv[1:]
+results = []
+for used in (False, True):
+    daemon = Daemon('--gpu', source + '=dry-run', '--gpu', target + '=dry-run', '--no-auto-attach')
+    app = None
+    try:
+        env = daemon.env({'ZSS_START_ON': source, 'ZSS_RETAIN': 'ram'})
+        for key in ('DRI_PRIME', 'MESA_VK_DEVICE_SELECT', 'MESA_VK_DEVICE_SELECT_FORCE_DEFAULT_DEVICE',
+                    'VK_DRIVER_FILES', 'VK_ICD_FILENAMES', 'VK_INSTANCE_LAYERS', 'LD_PRELOAD'):
+            env.pop(key, None)
+        with tempfile.TemporaryFile(mode='w+') as log:
+            app = subprocess.Popen(['/bin/sh', ZSS_RUN, '--plain', BUILD + '/tests/zss-query-probe',
+                                    *(['use'] if used else [])], env=env, stdin=subprocess.PIPE,
+                                   stdout=subprocess.PIPE, stderr=log, text=True)
+            with selectors.DefaultSelector() as selector:
+                selector.register(app.stdout, selectors.EVENT_READ)
+                check(bool(selector.select(timeout=8)), 'Query probe did not become ready')
+            check(app.stdout.readline().strip() == 'ready', 'Query probe startup failed')
+            rc, before = daemon.ctl('status')
+            check(rc == 0 and str(app.pid) in before, before)
+            rc, moved = daemon.ctl('move', source, '--to', target, timeout=15)
+            if used:
+                check(rc != 0 and 'query commands' in before, before + moved)
+            else:
+                check(rc == 0, moved)
+                rc, status = daemon.ctl('status')
+                check(rc == 0 and 'migrated-away' in status, status)
+                rc, returned = daemon.ctl('move', target, '--to', source, timeout=15)
+                check(rc == 0, returned)
+                rc, restored = daemon.ctl('restore', source, timeout=15)
+                check(rc == 0, restored)
+            app.communicate('\n', timeout=5)
+            check(app.returncode == 0, 'Query probe shutdown failed')
+            results.append({'used': used, 'pass': True, 'before': before, 'move': moved})
+    finally:
+        if app is not None and app.poll() is None:
+            app.kill(); app.wait()
+        daemon.stop()
+print(json.dumps({'pass': True, 'source': source, 'target': target, 'cases': results}, indent=2))
