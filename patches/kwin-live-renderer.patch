+QString CompositorDBusInterface::primaryGpu() const
+{
+    const auto device = m_compositor->primaryDevice();
+    return device ? device->path() : QString();
+}
+
+QStringList CompositorDBusInterface::renderDevices() const
+{
+    QStringList paths;
+    for (const auto &device : GpuManager::self()->renderDevices()) {
+        if (!device->isSoftwareDevice()) {
+            paths.push_back(device->path());
+        }
+    }
+    return paths;
+}
+
+bool CompositorDBusInterface::switchPrimaryGpu(const QString &devicePath)
+{
+    return m_compositor->switchPrimaryDevice(devicePath);
+}
+
+QString CompositorDBusInterface::gpuSwitchError() const
+{
+    return m_compositor->primaryDeviceSwitchError();
+}
