+    for(uint32_t b=0;b<2;b++)copy->u.dset.slot[b].type=VK_DESCRIPTOR_TYPE_UNIFORM_TEXEL_BUFFER;
+    zss_UpdateDescriptorSets((VkDevice)&dev,0,NULL,1,&cp);
+    assert(updates==2 && view->refs==5);
+    for(uint32_t b=0;b<2;b++)copy->u.dset.slot[b].type=VK_DESCRIPTOR_TYPE_STORAGE_TEXEL_BUFFER;
+    /* View recipe recreates against the new buffer handle. No descriptor
+     * update from the application is needed after migration. */
