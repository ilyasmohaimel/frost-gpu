diff --git a/tests/test_device_lifetime.c b/tests/test_device_lifetime.c
new file mode 100644
index 0000000..47e5b24
--- /dev/null
+++ b/tests/test_device_lifetime.c
@@ -0,0 +1,73 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Exercise actual destruction code against fake driver callbacks, without a GPU.
+ * A submit holds zss_lock while copying mapped buffers. Destruction of another
+ * buffer must wait before releasing its mapping, not only before unlinking it.
+ */
+#include "../src/layer/device.c"
+#include <errno.h>
+#include <stdatomic.h>
+
+pthread_mutex_t zss_lock = PTHREAD_RECURSIVE_MUTEX_INITIALIZER_NP;
+static pthread_mutex_t event_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t event = PTHREAD_COND_INITIALIZER;
+static atomic_bool entered, freed;
+
+void zss_enter(void) {}
+void zss_leave(void) {}
+void zss_retain_release(struct zss_ret *ret) {}
+void zss_shadow_free(uint8_t *p, VkDeviceSize size, bool watched) { free(p); }
+void zss_cmd_reset(struct zss_obj *cb) {}
+void zss_presenter_destroy(struct zss_presenter *p, bool gone) {}
+void zss_lower_forget_view(struct zss_dev *dev, VkImageView view) {}
+
+static void VKAPI_CALL fake_destroy(VkDevice d, VkBuffer b, const VkAllocationCallbacks *a)
+{
+    pthread_mutex_lock(&event_lock);
+    entered = true;
+    pthread_cond_signal(&event);
+    pthread_mutex_unlock(&event_lock);
+}
+
+static void VKAPI_CALL fake_free(VkDevice d, VkDeviceMemory m, const VkAllocationCallbacks *a)
+{
+    freed = true;
+}
+
+static void *destroy_thread(void *arg)
+{
+    struct zss_obj *o = arg;
+    zss_DestroyBuffer((VkDevice)o->dev, ZHANDLE(VkBuffer, o), NULL);
+    return NULL;
+}
+
+int main(void)
+{
+    struct zss_dev dev = { .real = (VkDevice)(uintptr_t)1 };
+    struct zss_obj *o = zss_obj_new(&dev, ZK_BUFFER);
+    pthread_t worker;
+    struct timespec until;
+    int rc = 0;
+
+    dev.fn.DestroyBuffer = fake_destroy;
+    dev.fn.FreeMemory = fake_free;
+    o->r.h = 1;
+    o->r.backing = (VkDeviceMemory)(uintptr_t)1;
+    pthread_mutex_lock(&zss_lock); // stand in for the real mapped-memory scan
+    pthread_mutex_lock(&event_lock);
+    if (pthread_create(&worker, NULL, destroy_thread, o)) return 2;
+    clock_gettime(CLOCK_REALTIME, &until);
+    until.tv_nsec += 150000000;
+    if (until.tv_nsec >= 1000000000) { until.tv_sec++; until.tv_nsec -= 1000000000; }
+    while (!entered && rc != ETIMEDOUT)
+        rc = pthread_cond_timedwait(&event, &event_lock, &until);
+    const bool raced = entered || freed;
+    pthread_mutex_unlock(&event_lock);
+    pthread_mutex_unlock(&zss_lock);
+    pthread_join(worker, NULL);
+    if (raced || !entered || !freed || dev.head || dev.tail) {
+        fprintf(stderr, "FAIL: mapped object destruction raced the memory scan\n");
+        return 1;
+    }
+    puts("PASS: driver destruction waits for mapped-memory scans");
+    return 0;
+}
diff --git a/tests/test_launcher.py b/tests/test_launcher.py
new file mode 100644
index 0000000..6cb5602
--- /dev/null
+++ b/tests/test_launcher.py
@@ -0,0 +1,79 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Launcher compatibility tests; fake app binaries, no display or GPU needed."""
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+
+LAUNCHER = Path(__file__).resolve().parents[1] / 'src/layer/zss-run.in'
+
+class ChromiumDisplayTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.root = Path(self.tmp.name)
+        self.app = self.root / 'test-chromium'
+        self.app.write_text('#!/bin/sh\nexit 0\n')
+        self.app.chmod(0o755)
+        (self.root / 'icudtl.dat').touch()
+        (self.root / 'v8_context_snapshot.bin').touch()
+        self.env = dict(os.environ, XDG_SESSION_TYPE='wayland', WAYLAND_DISPLAY='test-wayland')
+        self.env.pop('ZSS_CHROMIUM_PLATFORM', None)
+
+    def launch(self, *args, plain=False, env=None):
+        return subprocess.run(['/bin/sh', str(LAUNCHER), '--print', *(['--plain'] if plain else []),
+            str(self.app), *args], env=env or self.env, capture_output=True, text=True, timeout=5)
+
+    def test_wayland_session_uses_xwayland_for_chromium(self):
+        r = self.launch()
+        self.assertEqual(r.returncode, 0, r.stderr)
+        self.assertIn('--ozone-platform=x11', r.stdout)
+        self.assertIn('--use-angle=vulkan', r.stdout)
+
+    def test_explicit_wayland_choice_is_preserved(self):
+        r = self.launch('--ozone-platform=wayland')
+        self.assertIn('--ozone-platform=wayland', r.stdout)
+        self.assertNotIn('--ozone-platform=x11', r.stdout)
+
+    def test_split_platform_argument_is_preserved(self):
+        r = self.launch('--ozone-platform', 'wayland')
+        self.assertNotIn('--ozone-platform=x11', r.stdout)
+
+    def test_plain_does_not_change_graphics_arguments(self):
+        r = self.launch(plain=True)
+        self.assertNotIn('--ozone-platform', r.stdout)
+        self.assertNotIn('--use-angle', r.stdout)
+
+    def test_non_chromium_app_is_not_changed(self):
+        (self.root / 'icudtl.dat').unlink()
+        r = self.launch()
+        self.assertNotIn('--ozone-platform', r.stdout)
+
+    def test_explicit_environment_choice(self):
+        r = self.launch(env=dict(self.env, ZSS_CHROMIUM_PLATFORM='wayland'))
+        self.assertIn('--ozone-platform=wayland', r.stdout)
+        self.assertNotIn('--ozone-platform=x11', r.stdout)
+
+    def test_invalid_choice_fails_clearly(self):
+        r = self.launch(env=dict(self.env, ZSS_CHROMIUM_PLATFORM='unsupported'))
+        self.assertNotEqual(r.returncode, 0)
+        self.assertIn('must be x11 or wayland', r.stderr)
+
+    def test_x11_session_keeps_existing_default(self):
+        env = dict(self.env, XDG_SESSION_TYPE='x11')
+        env.pop('WAYLAND_DISPLAY', None)
+        r = self.launch(env=env)
+        self.assertNotIn('--ozone-platform', r.stdout)
+
+    def test_child_gpu_filters_are_cleared_and_start_choice_preserved(self):
+        self.app.write_text('#!/bin/sh\nprintf "%s\\n" "${DRI_PRIME-unset}" "${MESA_VK_DEVICE_SELECT-unset}" "${MESA_VK_DEVICE_SELECT_FORCE_DEFAULT_DEVICE-unset}" "$ZSS_START_ON"\n')
+        env = dict(self.env, DRI_PRIME='pci-0000_03_00_0', MESA_VK_DEVICE_SELECT='1002:73df!', MESA_VK_DEVICE_SELECT_FORCE_DEFAULT_DEVICE='1')
+        r = subprocess.run(['/bin/sh', str(LAUNCHER), '--plain', '--on', 'any', str(self.app)], env=env, capture_output=True, text=True, timeout=5)
+        self.assertEqual(r.returncode, 0, r.stderr)
+        self.assertEqual(r.stdout.splitlines(), ['unset', 'unset', 'unset', 'any'])
+        self.assertEqual(env['DRI_PRIME'], 'pci-0000_03_00_0')
+
+if __name__ == '__main__':
+    unittest.main()
