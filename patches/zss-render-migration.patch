+    zss_real_destroy(&dev,ZK_BUFFERVIEW,&old);view->r.h=0;
+    buf->r.h=44;expected_buffer=(VkBuffer)(uintptr_t)44;
+    assert(real_buffer_view(&dev,view)==VK_SUCCESS);
+    expected_view=(VkBufferView)(uintptr_t)view->r.h;zss_dset_apply(&dev,set);
