+    dev.native_maint5=true;view_result=VK_ERROR_OUT_OF_DEVICE_MEMORY;
+    assert(real_buffer_view(&dev,view)==view_result);
+    assert(view->r.h==(uint64_t)(uintptr_t)expected_view);view_result=VK_SUCCESS;
+    struct zss_obj *cb=zss_obj_new(&dev,ZK_CMDBUF);
+    cb->u.cb.level=VK_COMMAND_BUFFER_LEVEL_PRIMARY;cb->u.cb.nrefs=1;cb->u.cb.refs=calloc(1,sizeof(void *));cb->u.cb.refs[0]=copy;zss_obj_ref(copy);
+    struct zss_obj *bound_sets[]={copy};
