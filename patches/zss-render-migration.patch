+    for(uint32_t stage=0;stage<3;stage++){
+        if(stage && getchar()!='\n')return 5;
+        for(uint32_t repeat=0;repeat<2;repeat++){
+            VkSubmitInfo si={.sType=VK_STRUCTURE_TYPE_SUBMIT_INFO,.commandBufferCount=1,.pCommandBuffers=&cb};OK(vkQueueSubmit(queue,1,&si,VK_NULL_HANDLE));OK(vkQueueWaitIdle(queue));
+            uint32_t expected=5*(stage*2+repeat+1);
+            if(*mapped[1]!=expected){fprintf(stderr,"storage mismatch stage=%u repeat=%u expected=%u actual=%u\n",stage,repeat,expected,*mapped[1]);return 6;}
+        }
