+    VkBufferUsageFlags2CreateInfo usage={.sType=VK_STRUCTURE_TYPE_BUFFER_USAGE_FLAGS_2_CREATE_INFO,.usage=VK_BUFFER_USAGE_UNIFORM_TEXEL_BUFFER_BIT};
+    VkBufferViewCreateInfo ci={.sType=VK_STRUCTURE_TYPE_BUFFER_VIEW_CREATE_INFO,.pNext=&usage,.buffer=ZHANDLE(VkBuffer,buf),.format=VK_FORMAT_R32_UINT,.offset=16,.range=64};
