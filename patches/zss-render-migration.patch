+static void storage_set_dirty(struct zss_obj *set)
+{
+    if (!set || set->kind != ZK_DSET)
+        return;
+    for (uint32_t b = 0; b < set->u.dset.nslots; b++) {
+        const struct zss_slot *slot = &set->u.dset.slot[b];
+        for (uint32_t i = 0; i < slot->count; i++) {
+            const struct zss_slot_entry *e = &slot->e[i];
+            if (!e->written)
+                continue;
+            if ((slot->type == VK_DESCRIPTOR_TYPE_STORAGE_BUFFER || slot->type == VK_DESCRIPTOR_TYPE_STORAGE_BUFFER_DYNAMIC) && e->buffer)
+                buffer_dirty(e->buffer);
+            else if (slot->type == VK_DESCRIPTOR_TYPE_STORAGE_TEXEL_BUFFER && e->buffer_view)
+                buffer_dirty(ZOBJ(e->buffer_view->u.buffer_view.ci.buffer));
+            else if (slot->type == VK_DESCRIPTOR_TYPE_STORAGE_IMAGE && e->view)
+                zss_image_dirty(ZOBJ(e->view->u.view.ci.image), true);
+        }
+    }
+}
