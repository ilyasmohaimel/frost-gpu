+bool Compositor::switchPrimaryDevice(const QString &devicePath)
+{
+    m_primaryDeviceSwitchError.clear();
+    const auto reject = [this](const QString &reason) {
+        m_primaryDeviceSwitchError = reason;
+        qCWarning(KWIN_CORE) << reason;
+        return false;
+    };
+    if (!environmentVariableBoolValue("KWIN_ENABLE_EXPERIMENTAL_GPU_SWITCH").value_or(false)) {
+        return reject(QStringLiteral("Experimental GPU switching was not enabled at startup"));
+    }
+    if (waylandServer()->isScreenLocked()) {
+        return reject(QStringLiteral("GPU switching is paused while the session is locked"));
+    }
+    if (m_state != State::On || kwinApp()->isTerminating()
+        || m_backend->compositingType() != OpenGLCompositing) {
+        return reject(QStringLiteral("Compositor is not in a state that permits GPU switching"));
+    }
+
+    struct stat info;
+    if (stat(devicePath.toLocal8Bit().constData(), &info) != 0 || !S_ISCHR(info.st_mode)) {
+        return reject(QStringLiteral("Target must be an existing DRM character device"));
+    }
+    RenderDevice *target = GpuManager::self()->compatibleRenderDevice(info.st_rdev);
+    if (!target || target->isSoftwareDevice() || target->isInReset()) {
+        return reject(QStringLiteral("Target is unavailable, software-rendered, or resetting"));
+    }
+    if (target == m_primaryDevice) {
+        return true;
+    }
+    if (!m_primaryDeviceSwitchBlockers.isEmpty()) {
+        return reject(QStringLiteral("GPU switching is blocked by an active screencast source"));
+    }
+
+    // Check the new context before touching the working compositor. Keep the
+    // check scoped so it does not retain a context after a failed request.
+    {
+        const auto previousContext = static_cast<EglBackend *>(m_backend.get())->openglContextRef();
+        const auto context = target->eglContext();
+        const bool ready = context && context->makeCurrent();
+        const bool restored = previousContext->makeCurrent();
+        if (!ready || !restored) {
+            return reject(QStringLiteral("Could not initialize the target GPU's EGL context"));
+        }
+    }
+
+    RenderDevice *previous = m_primaryDevice;
+    stop();
+    m_primaryDevice = target;
+    bool switched = false;
+#ifndef NDEBUG
+    // Only for isolated debug-build fault-injection tests of the rollback path.
+    if (qEnvironmentVariable("KWIN_TEST_GPU_SWITCH_REJECT_TARGET") != target->path())
+#endif
+    {
+        switched = attemptOpenGLCompositing();
+    }
+    if (!switched) {
+        // Do not call start() without a backend: its ordinary startup failure
+        // path quits KWin. A failed request must restore the previous renderer.
+        m_primaryDevice = previous;
+        if (!attemptOpenGLCompositing()) {
+            qCCritical(KWIN_CORE) << "GPU switch and rollback both failed; compositing remains stopped";
+            return reject(QStringLiteral("GPU switch and rollback failed; compositing remains stopped"));
+        }
+        m_primaryDeviceSwitchError = QStringLiteral("Target renderer failed; the previous GPU was restored");
+    }
+    start();
+    Q_EMIT primaryGpuChanged();
+    // Rebuild the entire output after replacing all renderer resources,
+    // including surfaces that have not submitted new damage.
+    kwinApp()->scene()->addRepaintFull();
+    qCInfo(KWIN_CORE) << "Primary renderer switched from" << previous->path()
+                     << "to" << m_primaryDevice->path();
+    return switched;
+}
+
+QString Compositor::primaryDeviceSwitchError() const
+{
+    return m_primaryDeviceSwitchError;
+}
+
+void Compositor::blockPrimaryDeviceSwitch(QObject *owner)
+{
+    m_primaryDeviceSwitchBlockers.insert(owner);
+    connect(owner, &QObject::destroyed, this, [this, owner]() {
+        m_primaryDeviceSwitchBlockers.remove(owner);
+    });
+}
+
