+static struct zss_obj *keep_buffer_view(struct zss_dev *dev, const VkBufferViewCreateInfo *ci)
+{
+    struct zss_obj *o = zss_obj_new(dev, ZK_BUFFERVIEW);
+    if (!o)
+        return NULL;
+    o->u.buffer_view.ci = *ci;
+    o->u.buffer_view.ci.pNext = zss_chain_keep(o, ci->pNext);
+    zss_obj_dep(o, ZOBJ(ci->buffer));
+    return o;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL zss_CreateBufferView(VkDevice device, const VkBufferViewCreateInfo *ci,
+                                                   const VkAllocationCallbacks *alloc, VkBufferView *out)
+{
+    ENTER(device);
+    struct zss_obj *o = keep_buffer_view(dev, ci);
+
+    (void)alloc;
+    if (!o) {
+        *out = VK_NULL_HANDLE;
+        zss_leave();
+        return VK_ERROR_OUT_OF_HOST_MEMORY;
+    }
+    return finish_create(dev, o, (uint64_t *)out);
