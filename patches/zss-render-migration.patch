--- /dev/null
+++ b/tests/test_texel_buffers.py
@@ -0,0 +1,51 @@
+#!/usr/bin/env python3
+"""Two real GPUs, six one-fragment draws, same descriptors and mapped pointers."""
+import json
+import os
+from pathlib import Path
+import selectors
+import subprocess
+import sys
+import tempfile
+from zsstest import Daemon, BUILD, ZSS_RUN, check
+
+source,target=sys.argv[1:3]
+baseline='--baseline' in sys.argv[3:]
+daemon=Daemon('--gpu',source+'=dry-run','--gpu',target+'=dry-run','--no-auto-attach')
+app=None
+result={'pass':False,'baseline':baseline,'source':source,'target':target,'submissions':6,'fragmentsPerSubmission':1,'stages':[]}
+try:
+ env=daemon.env({'ZSS_START_ON':source,'ZSS_RETAIN':'ram'})
+ for key in ('DRI_PRIME','MESA_VK_DEVICE_SELECT','MESA_VK_DEVICE_SELECT_FORCE_DEFAULT_DEVICE','VK_DRIVER_FILES','VK_ICD_FILENAMES','VK_INSTANCE_LAYERS','LD_PRELOAD'):
+  env.pop(key,None)
+ if baseline:env['ZSS_MANIFEST']='/opt/frost-gpu/share/zss_icd.json'
+ with tempfile.TemporaryFile(mode='w+') as log:
+  app=subprocess.Popen(['/bin/sh',ZSS_RUN,'--plain',BUILD+'/tests/zss-texel-probe'],env=env,stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=log,text=True)
+  result['pid']=app.pid
+  def stage(n):
+   with selectors.DefaultSelector() as select:
+    select.register(app.stdout,selectors.EVENT_READ)
+    check(bool(select.select(timeout=12)),'Texel probe timed out')
+   line=app.stdout.readline().strip()
+   check(line==f'stage {n} value {(n+1)*10}','Unexpected storage readback: '+repr(line))
+   result['stages'].append({'index':n,'value':(n+1)*10})
+  try:
+   stage(0)
+   rc,before=daemon.ctl('status');result['before']=before
+   check(rc==0 and 'migratable\n' in before,before)
+   for n,(origin,dest) in enumerate(((source,target),(target,source)),1):
+    rc,moved=daemon.ctl('move',origin,'--to',dest,timeout=20)
+    check(rc==0,moved)
+    app.stdin.write('\n');app.stdin.flush();stage(n)
+   app.communicate(timeout=5);check(app.returncode==0,'Probe cleanup failed')
+   result['pass']=True
+  except Exception as error:
+   result['error']=str(error)
+  finally:
+   if app.poll() is None:app.kill();app.wait()
+   log.seek(0);result['logTail']=log.read()[-1500:]
+finally:
+ if app is not None and app.poll() is None:app.kill();app.wait()
+ daemon.stop()
+print(json.dumps(result,indent=2))
+raise SystemExit(0 if result['pass'] else 1)
